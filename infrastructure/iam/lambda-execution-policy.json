{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "GlueJobAccess",
            "Effect": "Allow",
            "Action": [
                "glue:StartJobRun",
                "glue:GetJobRun",
                "glue:GetJob"
            ],
            "Resource": [
                "arn:aws:glue:eu-west-2:*:job/customer-data-cleansing-job"
            ]
        },
        {
            "Sid": "S3ReadAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": [
                "arn:aws:s3:::*-eu-west-2-datapipeline-raw/*"
            ]
        },
        {
            "Sid": "CloudWatchLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:eu-west-2:*:*"
        }
    ]
}
