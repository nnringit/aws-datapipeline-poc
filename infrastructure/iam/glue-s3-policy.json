{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::<ACCOUNT_ID>-eu-west-2-datapipeline-raw",
                "arn:aws:s3:::<ACCOUNT_ID>-eu-west-2-datapipeline-raw/*",
                "arn:aws:s3:::<ACCOUNT_ID>-eu-west-2-datapipeline-processed",
                "arn:aws:s3:::<ACCOUNT_ID>-eu-west-2-datapipeline-processed/*"
            ]
        }
    ]
}
